# --- eBay official Browse API (recommended / terms-compliant marketplace) ---
# Free developer keyset: https://developer.ebay.com/signin
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Deal alerts ---
# Any URL that accepts a POST. Leave the style on "json" for Slack/Discord/your own
# endpoint; use "text" for ntfy.sh (then the URL is https://ntfy.sh/<your-topic>).
MARKETWATCH_WEBHOOK_URL=
MARKETWATCH_WEBHOOK_STYLE=json

# --- leboncoin (optional tuning; the watch is the opt-in, not this file) ---
# auto tries the JSON endpoint first, then the search page.
MARKETWATCH_LBC_TRANSPORT=auto
# Only if you want to use your own logged-in browser session: paste the Cookie
# header value from your browser devtools. Never commit this.
MARKETWATCH_LBC_COOKIE=

# --- Local paths ---
MARKETWATCH_DB=marketwatch.sqlite3
