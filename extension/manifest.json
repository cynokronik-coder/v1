{
  "manifest_version": 3,
  "name": "marketwatch - second-hand bargain finder",
  "version": "0.3.0",
  "description": "Estimates the real market price of a second-hand item, watches eleven second-hand marketplaces at once, and finds products that are cheaper to buy than to resell.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "notifications", "tabs", "cookies", "scripting"],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.vinted.de/*",
    "https://*.vinted.co.uk/*",
    "https://*.vinted.es/*",
    "https://*.vinted.it/*",
    "https://*.vinted.be/*",
    "https://*.vinted.nl/*",
    "https://*.vinted.pl/*",
    "https://*.vinted.pt/*",
    "https://*.vinted.at/*",
    "https://*.vinted.lt/*",
    "https://*.vinted.cz/*",
    "https://*.vinted.sk/*",
    "https://*.vinted.hu/*",
    "https://*.vinted.se/*",
    "https://*.vinted.dk/*",
    "https://*.vinted.ro/*",
    "https://*.leboncoin.fr/*",
    "https://api.ebay.com/*",
    "https://*.ebay.fr/*",
    "https://*.ebay.com/*",
    "https://*.backmarket.fr/*",
    "https://*.backmarket.com/*",
    "https://*.fnac.com/*",
    "https://*.cdiscount.com/*",
    "https://*.easycash.fr/*",
    "https://*.cashexpress.fr/*",
    "https://*.cashconverters.fr/*",
    "https://*.momox.fr/*",
    "https://*.momox-shop.fr/*",
    "https://*.facebook.com/*",
    "https://api.apify.com/*",
    "https://serpapi.com/*",
    "https://api.brightdata.com/*",
    "https://api.keepa.com/*",
    "https://wikimedia.org/*",
    "https://api.gdeltproject.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "marketwatch - open the dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
